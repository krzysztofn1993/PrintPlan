---
import { SpoolInventory } from "@/components/spools/SpoolInventory";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { applySpoolPrivateHeaders, mapSpoolDatabaseError } from "@/lib/spool-response";
import { listSpools, type SpoolDto } from "@/lib/spools";

const { authUnavailable, supabase, user } = Astro.locals;
applySpoolPrivateHeaders(Astro.response.headers);

let initialSpools: SpoolDto[] = [];
let pageError: string | undefined;

if (authUnavailable || !supabase) {
  Astro.response.status = 503;
  pageError = "Stock is temporarily unavailable. Please try again.";
} else if (!user) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/auth/signin");
} else {
  const result = await listSpools(supabase, user.id);
  if (result.ok) {
    initialSpools = result.value;
  } else {
    const failure = mapSpoolDatabaseError(result.error);
    const status = failure.status === 503 ? 503 : 500;
    Astro.response.status = status;
    pageError =
      status === 503
        ? "Stock is temporarily unavailable. Please try again."
        : "We couldn't load your stock. Please try again.";
  }
}
---

<Layout title="Filament stock">
  <main class="bg-cosmic min-h-screen px-4 py-4 text-white sm:px-8 sm:py-8">
    <div class="mx-auto max-w-5xl">
      <Topbar />
      <header class="mb-8 rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-8">
        <p class="text-sm font-medium uppercase tracking-wide text-purple-200">Personal inventory</p>
        <h1 class="mt-2 break-words text-3xl font-bold text-white sm:text-4xl">Filament stock</h1>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-blue-100/75 sm:text-base">
          Record an estimate of the filament you have. Reserved grams are set aside for planned prints; available grams
          are recorded stock minus reserved stock. A recorded estimate does not guarantee how much filament is
          physically on a spool.
        </p>
      </header>

      {pageError ? (
        <section
          role="alert"
          aria-labelledby="stock-error-heading"
          class="rounded-xl border border-destructive/40 bg-destructive/10 p-5 sm:p-6"
        >
          <h2 id="stock-error-heading" class="text-lg font-semibold text-white">
            Stock could not be loaded
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-blue-100/80">{pageError}</p>
          <a
            href="/dashboard/spools"
            class="mt-3 inline-flex min-h-11 items-center font-semibold text-purple-200 underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-purple-300"
          >
            Try again
          </a>
        </section>
      ) : (
        <SpoolInventory client:load initialSpools={initialSpools} />
      )}
    </div>
  </main>
</Layout>
