---
import { SpoolInventory } from "@/components/spools/SpoolInventory";
import DashboardShell from "@/layouts/DashboardShell.astro";
import { applySpoolPrivateHeaders, mapSpoolDatabaseError, reportSpoolFailure } from "@/lib/spool-response";
import { listSpools, type SpoolDto } from "@/lib/spools";

const { authUnavailable, supabase, user } = Astro.locals;
applySpoolPrivateHeaders(Astro.response.headers);

let initialSpools: SpoolDto[] = [];
let pageError: string | undefined;

if (authUnavailable || !supabase) {
  Astro.response.status = 503;
  pageError = "Stock is temporarily unavailable. Please try again.";
} else if (!user) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/auth/signin");
} else {
  const result = await listSpools(supabase, user.id);
  if (result.ok) {
    initialSpools = result.value;
  } else {
    const failure = mapSpoolDatabaseError(result.error, result.status);
    reportSpoolFailure(failure, "page");
    const status = failure.status === 503 ? 503 : 500;
    Astro.response.status = status;
    pageError =
      status === 503
        ? "Stock is temporarily unavailable. Please try again."
        : "We couldn't load your stock. Please try again.";
  }
}
---

<DashboardShell title="Filament stock" heading="Filament stock">
  <p slot="eyebrow">Personal inventory</p>
  <p slot="description">
    Record an estimate of the filament you have. Reserved grams are set aside for planned prints; available grams are
    recorded stock minus reserved stock. A recorded estimate does not guarantee how much filament is physically on a
    spool.
  </p>

  {pageError ? (
    <section role="alert" aria-labelledby="stock-error-heading" class="carbon-page-error">
      <h2 id="stock-error-heading">Stock could not be loaded</h2>
      <p>{pageError}</p>
      <a href="/dashboard/spools" class="carbon-feedback-link">
        Try again
      </a>
    </section>
  ) : (
    <SpoolInventory client:load initialSpools={initialSpools} />
  )}
</DashboardShell>
