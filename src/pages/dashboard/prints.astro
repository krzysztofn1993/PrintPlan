---
import { PrintList } from "@/components/prints/PrintList";
import DashboardShell from "@/layouts/DashboardShell.astro";
import { applyPrintPrivateHeaders, mapPrintDatabaseError, reportPrintFailure } from "@/lib/print-response";
import { listPrints, type PrintDto } from "@/lib/prints";

const { authUnavailable, supabase, user } = Astro.locals;
applyPrintPrivateHeaders(Astro.response.headers);

let initialPrints: PrintDto[] = [];
let pageError: string | undefined;

if (authUnavailable || !supabase) {
  Astro.response.status = 503;
  pageError = "Prints are temporarily unavailable. Please try again.";
} else if (!user) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/auth/signin");
} else {
  const result = await listPrints(supabase, user.id);
  if (result.ok) {
    initialPrints = result.value;
  } else {
    const failure = mapPrintDatabaseError(result.error, result.status, "read");
    reportPrintFailure(failure, "page");
    const status = failure.status === 503 ? 503 : 500;
    Astro.response.status = status;
    pageError =
      status === 503
        ? "Prints are temporarily unavailable. Please try again."
        : "We couldn't load your prints. Please try again.";
  }
}
---

<DashboardShell title="Prints" heading="Prints">
  <p slot="eyebrow">Planned and completed prints</p>
  <p slot="description">
    Keep planned prints and completed prints together. Required grams are an estimate; reserved grams are held for a
    planned print and are not consumed. Preview the reservation amount, then confirm it using the current account safety
    margin. If the margin changes the amount before confirmation, review a fresh preview. Change your margin in{" "}
    <a class="carbon-feedback-link" href="/dashboard/settings">
      Settings
    </a>
    . Releasing a reservation returns those grams to availability without consuming recorded stock. When a print is
    complete, enter actual grams to release its exact reservation and deduct that amount from recorded stock. Settlement
    may cancel newer reservations on the same spool when the remaining stock cannot cover them. Completed prints stay
    here for review and can be deleted without refunding consumed stock.
  </p>

  {pageError ? (
    <section role="alert" aria-labelledby="prints-error-heading" class="carbon-page-error">
      <h2 id="prints-error-heading">Prints could not be loaded</h2>
      <p>{pageError}</p>
      <a href="/dashboard/prints" class="carbon-feedback-link">
        Try again
      </a>
    </section>
  ) : (
    <PrintList client:load initialPrints={initialPrints} />
  )}
</DashboardShell>
