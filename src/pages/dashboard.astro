---
import DashboardShell from "@/layouts/DashboardShell.astro";

const { user } = Astro.locals;
---

<DashboardShell title="Dashboard" heading="Dashboard">
  <section class="carbon-panel carbon-dashboard-panel">
    <p class="carbon-dashboard-welcome">
      Welcome, <span class="carbon-dashboard-identity">{user?.email}</span>
    </p>
    <p class="carbon-dashboard-copy">Manage your filament stock and prints.</p>
    <div class="carbon-dashboard-actions">
      <a href="/dashboard/spools" class="carbon-dashboard-link carbon-dashboard-link-primary">
        Manage filament stock
      </a>
      <a href="/dashboard/prints" class="carbon-dashboard-link">
        Manage prints
      </a>
    </div>
  </section>
</DashboardShell>
