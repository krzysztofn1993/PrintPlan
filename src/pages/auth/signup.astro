---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { getAuthFormErrorMessage } from "@/lib/auth-response";
import { getSignUpFieldError, type FieldErrors, type SignUpField, type ValidationCode } from "@/lib/auth-validation";

const error = getAuthFormErrorMessage("signup", Astro.url.searchParams.get("error"));
const initialErrors: FieldErrors<SignUpField> = {};
if (Astro.url.searchParams.get("error") === "validation") {
  for (const entry of Astro.url.searchParams.get("fields")?.split(",") ?? []) {
    const [field, code] = entry.split(":");
    if (field === "email" || field === "password" || field === "confirmPassword") {
      const message = getSignUpFieldError(field, code as ValidationCode);
      if (message) initialErrors[field] = message;
    }
  }
}
---

<Layout title="Sign up">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Sign up
      </h1>
      <SignUpForm serverError={error} initialErrors={initialErrors} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Already have an account?{" "}
        <a href="/auth/signin" class="text-purple-300 hover:underline">
          Sign in
        </a>
      </p>
    </div>
  </div>
</Layout>
