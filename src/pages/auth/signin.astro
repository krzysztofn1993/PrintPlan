---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { getAuthFormErrorMessage } from "@/lib/auth-response";
import { getSignInFieldError, type FieldErrors, type SignInField, type ValidationCode } from "@/lib/auth-validation";

const error = getAuthFormErrorMessage("signin", Astro.url.searchParams.get("error"));
const initialErrors: FieldErrors<SignInField> = {};
if (Astro.url.searchParams.get("error") === "validation") {
  for (const entry of Astro.url.searchParams.get("fields")?.split(",") ?? []) {
    const [field, code] = entry.split(":");
    if (field === "email" || field === "password") {
      const message = getSignInFieldError(field, code as ValidationCode);
      if (message) initialErrors[field] = message;
    }
  }
}
---

<Layout title="Sign in">
  <main class="carbon-workspace flex min-h-screen items-center justify-center p-4">
    <section class="carbon-panel carbon-panel-highlight w-full max-w-sm p-6 sm:p-8">
      <h1 class="mb-6 flex items-center justify-center gap-3 text-center text-2xl font-bold text-foreground">
        <span aria-hidden="true" class="carbon-led"></span>
        Sign in
      </h1>
      <SignInForm serverError={error} initialErrors={initialErrors} client:load />
      <p class="mt-4 text-center text-sm text-muted-foreground">
        Don't have an account?{" "}
        <a href="/auth/signup" class="text-accent-foreground underline-offset-4 hover:underline">
          Sign up
        </a>
      </p>
    </section>
  </main>
</Layout>
