---
const { user, authUnavailable } = Astro.locals;
const currentPath = Astro.url.pathname;
---

<nav
  aria-label="Account navigation"
  class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80"
>
  {user ? (
    <>
      <span class="min-w-0 break-words text-blue-100/70">{user.email}</span>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
        <a
          href="/dashboard"
          aria-current={currentPath === "/dashboard" ? "page" : undefined}
          class="inline-flex min-h-11 items-center text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0e1a]"
        >
          Dashboard
        </a>
        <a
          href="/dashboard/spools"
          aria-current={currentPath.startsWith("/dashboard/spools") ? "page" : undefined}
          class="inline-flex min-h-11 items-center text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0e1a]"
        >
          Filament stock
        </a>
        <form method="POST" action="/api/auth/signout" class="flex">
          <button
            type="submit"
            class="inline-flex min-h-11 items-center text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0e1a]"
          >
            Sign out
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-blue-100/70">
        {authUnavailable ? "Authentication status is temporarily unavailable" : "Not signed in"}
      </span>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        <a
          href="/auth/signin"
          class="inline-flex min-h-11 items-center text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0e1a]"
        >
          Sign in
        </a>
        <a
          href="/auth/signup"
          class="inline-flex min-h-11 items-center text-purple-300 transition-colors hover:text-purple-100 hover:underline focus-visible:ring-2 focus-visible:ring-purple-300 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0e1a]"
        >
          Sign up
        </a>
      </div>
    </>
  )}
</nav>
