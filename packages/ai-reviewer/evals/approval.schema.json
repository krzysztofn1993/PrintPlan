{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled"],
  "properties": {
    "enabled": { "type": "boolean" },
    "mode": { "enum": ["comparison", "gate"] },
    "models": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "enum": [
          "case-01",
          "case-02",
          "case-03",
          "case-04",
          "case-05",
          "case-06",
          "case-07",
          "case-08",
          "case-09",
          "case-10",
          "case-11",
          "case-12",
          "case-13",
          "case-14",
          "case-15",
          "case-16",
          "case-17",
          "case-18"
        ]
      }
    },
    "requestCount": { "type": "integer", "minimum": 0, "maximum": 162 },
    "repetitions": { "const": 3 },
    "usdLimit": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "approvalId": { "type": ["string", "null"], "minLength": 1 },
    "invocationId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "issuedAt": { "type": ["string", "null"], "format": "date-time" },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "runnerDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "corpusDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "schemaDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "pricingDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 8000 },
    "promptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recurringAuthorized": { "type": "boolean" },
    "candidatePaths": { "type": "array", "items": { "type": "string" } },
    "maxPromptBytes": { "type": "integer", "minimum": 1 },
    "maxInputTokens": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": [
          "mode",
          "models",
          "caseIds",
          "requestCount",
          "repetitions",
          "usdLimit",
          "approvalId",
          "invocationId",
          "issuedAt",
          "expiresAt",
          "runnerDigest",
          "corpusDigest",
          "schemaDigest",
          "pricingDigest"
        ],
        "properties": {
          "requestCount": { "type": "integer", "minimum": 1, "maximum": 162 },
          "usdLimit": { "type": "number", "exclusiveMinimum": 0 },
          "approvalId": { "type": "string", "minLength": 1 },
          "invocationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
          "issuedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "runnerDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "corpusDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "schemaDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "pricingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  ]
}
